# Pullmanager connection settings.
#
# Both connections use Windows integrated auth (Trusted_Connection=yes), so
# there are no credentials here -- only host and database names.
#
# Copy to .env on the VM and fill in. .env is gitignored.

# Cosmos. The server is a DNS alias; the real instance name is discovered at
# run time with @@SERVERNAME, because it changes on every connection.
PULLMANAGER_COSMOS_SERVER=COSMOS
PULLMANAGER_COSMOS_DATABASE=COSMOS

# Projects. The database is per project and normally comes from the manifest's
# project_db; this is the fallback.
PULLMANAGER_PROJECTS_SERVER=
PULLMANAGER_PROJECTS_DATABASE=

# ODBC driver. Driver 17 is what is installed on the VM and defaults to
# Encrypt=no. Driver 18 flips that default and needs certificate handling.
PULLMANAGER_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# Seconds. Login timeout guards a wrong host; query timeout 0 means no limit,
# which long Cosmos pulls need.
PULLMANAGER_LOGIN_TIMEOUT=10
PULLMANAGER_QUERY_TIMEOUT=0

# Rows per parameterized bulk insert. fast_executemany allocates buffers from
# declared column width times batch size, so this trades memory for round trips.
PULLMANAGER_UPLOAD_CHUNK=20000
